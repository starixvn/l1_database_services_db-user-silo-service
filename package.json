        "@ldb/mongo": "6.10.1",
        "@ldb/scheduler": "3.0.1",
        "@ldb/sentry-logger": "1.1.0",
        "@ldb/skynex-logger": "1.1.3",
        "@ldb/terminal-logger": "1.1.3",
        "@ldb/types": "1.1.0",
        "awilix": "12.0.3"
    },
    "devDependencies": {
        "@commitlint/cli": "19.5.0",
        "@commitlint/config-conventional": "19.5.0",
        "@ldb/base-logger": "1.1.2",
        "@ldb/eslint-config": "0.2.0",
        "@ldb/prettier-config": "0.1.0",
        "@ldb/vitest-config": "0.0.1-rc.20",
        "@tsconfig/node20": "20.1.4",
        "@types/node": "22.9.0",
        "@vitest/coverage-v8": "2.1.4",
        "eslint": "9.14.0",
        "prettier": "3.3.3",
        "rimraf": "6.0.1",
        "typescript": "5.6.3",
        "vitest": "2.1.4"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
