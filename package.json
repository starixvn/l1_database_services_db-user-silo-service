{
    "name": "db-user-silo-service",
    "license": "ISC",
    "type": "module",
    "scripts": {
        "test": "NODE_OPTIONS=\"--experimental-vm-modules --es-module-specifier-resolution=node --no-warnings\" jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "NODE_OPTIONS=\"--experimental-vm-modules --es-module-specifier-resolution=node --no-warnings\" jest --collect-coverage --passWithNoTests --testPathPattern=tests/unit-tests/",
        "build": "rimraf lib && tsc",
        "dev": "NODE_OPTIONS=\"--enable-source-maps --no-warnings --experimental-default-type=module --es-module-specifier-resolution=node\" node lib/index.js"
    },
    "engines": {
        "node": ">=18"
    },
    "files": [
        "lib/**"
    ],
    "dependencies": {
        "@ldb/logger": "1.0.0",
        "@ldb/mongo": "6.8.0",
        "@ldb/scheduler": "3.0.1",
        "@ldb/sentry-logger": "1.0.0",
        "@ldb/skynex-logger": "1.0.0",
        "@ldb/terminal-logger": "1.0.0",
        "@ldb/types": "1.1.0",
        "awilix": "10.0.2"
    },
    "devDependencies": {
        "@commitlint/cli": "19.3.0",
        "@commitlint/config-conventional": "19.2.2",
        "@jest/globals": "29.7.0",
        "@ldb/base-logger": "1.0.0",
        "@tsconfig/node20": "20.1.4",
        "@types/jest": "29.5.12",
        "@types/node": "20.14.11",
        "eslint": "8.57.0",
        "eslint-config-google": "0.14.0",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-security": "3.0.1",
        "jest": "29.7.0",
        "jest-extended": "4.0.2",
        "jest-html-reporters": "3.1.7",
        "jest-junit": "16.0.0",
        "jest-sonar-reporter": "2.0.0",
        "rimraf": "6.0.1",
        "ts-jest": "29.2.3",
        "ts-node": "10.9.2",
        "typescript": "5.5.3",
        "typescript-eslint": "7.16.1"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
