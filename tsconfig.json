{
    "extends": "@tsconfig/node20/tsconfig.json",
    "compilerOptions": {
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "sourceRoot": "/",
        "mapRoot": "/",
        "moduleResolution": "Node",
        "module": "ES2022",
        "target": "ES2022",
        "rootDir": "src",
        "outDir": "lib",
        "alwaysStrict": true
    },
    "compileOnSave": true,
    "include": ["src/**/*"]
}
